<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tháng trước"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#334155"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="September 2026" />

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tháng sau"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            style="@style/CalendarWeekday"
            android:text="Sun" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Mon" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Tue" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Wed" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Thu" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Fri" />

        <TextView
            style="@style/CalendarWeekday"
            android:text="Sat" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/gridDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alignmentMode="alignBounds"
        android:columnCount="7"
        android:useDefaultMargins="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Today"
                android:textColor="@color/quick_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipTomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Tomorrow"
                android:textColor="@color/quick_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipThreeDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="3 Days Later"
                android:textColor="@color/quick_chip_text_color"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipThisSunday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="This Sunday"
                android:textColor="@color/quick_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipNoDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="No Date"
                android:textColor="@color/quick_chip_text_color"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E8ECF1" />

    <LinearLayout
        android:id="@+id/rowTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_access_time"
            android:tint="#64748B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Time"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTimeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:textColor="#94A3B8"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8ECF1" />

    <LinearLayout
        android:id="@+id/rowReminder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_bell" />

        <TextView
            android:id="@+id/tvReminderLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Reminder"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvReminderValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:textColor="#94A3B8"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8ECF1" />

    <LinearLayout
        android:id="@+id/rowRepeat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_repeat"
            android:tint="#64748B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Repeat"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRepeatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:textColor="#94A3B8"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="CANCEL"
            android:textAllCaps="true"
            android:textColor="#8BB4F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="DONE"
            android:textAllCaps="true"
            android:textColor="#8BB4F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
